{
  "name": "personal-search",
  "version": "1.0.0",
  "description": "个人集成搜索工具：一次搜索同时检索本机文件（Everything / es.exe）与 OneNote 笔记（COM FindPages）。",
  "main": "dist-electron/main.js",
  "author": "Kou",
  "license": "MIT",
  "private": true,
  "os": [
    "win32"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.volcanochen.personal-search",
    "productName": "PersonalSearch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/onenote-search.ps1",
        "to": "onenote-search.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "fast-xml-parser": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7"
  }
}
